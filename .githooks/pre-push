#!/bin/sh
# Block a push unless it goes out as nordlyse / Jakob Lyse, with no agent identity.

remote_name="$1"
remote_url="$2"

case "$remote_url" in
  git@github.com:nordlyse/*|ssh://git@github.com/nordlyse/*|https://github.com/nordlyse/*|git://github.com/nordlyse/*)
    ;;
  *)
    echo "Push refused: remote must belong to the nordlyse GitHub account." >&2
    exit 1
    ;;
esac

auth_line=$(ssh -T -o BatchMode=yes -o ConnectTimeout=15 git@github.com 2>&1 || true)
case "$auth_line" in
  *"Hi nordlyse!"*)
    ;;
  *)
    echo "Push refused: SSH session is not nordlyse." >&2
    printf '%s\n' "$auth_line" >&2
    exit 1
    ;;
esac

name=$(git config user.name || true)
email=$(git config user.email || true)
if [ "$name" != "Jakob Lyse" ] || [ "$email" != "jakob.lyse@gmail.com" ]; then
  echo "Push refused: local git user must be Jakob Lyse <jakob.lyse@gmail.com>." >&2
  exit 1
fi

zero="0000000000000000000000000000000000000000"
forbidden='cursoragent|Co-authored-by:[[:space:]]*Cursor|omer\.kurtuld|OmerKurtuldu|omerkurtuldu@gmail\.com|CriticalSolution'

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha}" ] || continue
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero" ]; then
    commits=$(git rev-list "$local_sha" --not --remotes="$remote_name" 2>/dev/null || git rev-list "$local_sha")
  else
    commits=$(git rev-list "${remote_sha}..${local_sha}")
  fi

  for commit in $commits; do
    an=$(git log -1 --format='%an' "$commit")
    ae=$(git log -1 --format='%ae' "$commit")
    cn=$(git log -1 --format='%cn' "$commit")
    ce=$(git log -1 --format='%ce' "$commit")
    body=$(git log -1 --format='%B' "$commit")

    if [ "$an" != "Jakob Lyse" ] || [ "$ae" != "jakob.lyse@gmail.com" ] \
      || [ "$cn" != "Jakob Lyse" ] || [ "$ce" != "jakob.lyse@gmail.com" ]; then
      echo "Push refused: $commit is not from Jakob Lyse <jakob.lyse@gmail.com>." >&2
      exit 1
    fi

    if printf '%s\n' "$body" | grep -Eq "$forbidden"; then
      echo "Push refused: $commit includes cursoragent or another forbidden identity." >&2
      exit 1
    fi
  done
done

exit 0
